---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getPostUrl } from "@/utils/getPostPaths";
import config from "@/config";

const posts = getSortedPosts(await getCollection("posts")).sort(
  (a, b) => a.data.pubDatetime.getTime() - b.data.pubDatetime.getTime()
);
const topics = [
  {
    id: "coding-agent",
    title: "Coding Agent 原理与实践：Ink 开发手记",
    tag: "Coding Agent",
    description:
      "记录从零开发 Ink 的过程，按核心模块解释 Coding Agent 的原理、伪代码实现与工程取舍。",
    outline:
      "阅读路线：最小执行闭环 → 模型与工具 → 上下文与会话 → 交互与权限 → 扩展、协作与验证。",
    href: "/ink/",
  },
  {
    id: "building-a-blog",
    title: "个人博客搭建",
    tag: "博客搭建",
    description: "从框架与主题选择，到中文适配、内容管理、搜索和部署。",
    outline: undefined,
    href: undefined,
  },
];
---

<Layout
  title={`Ink 开发、Coding Agent 原理与博客搭建专题 | ${config.site.title}`}
  description="按顺序阅读 Coding Agent 原理与实践：结合 Ink 源码理解执行循环、模型接入、工具与子代理，也记录 Astro 个人博客的搭建过程。"
>
  <Header /><Breadcrumb />
  <Main
    pageTitle="技术专题"
    pageDesc="从 Ink 开发到个人博客搭建，把实践整理成可以循序阅读的目录。"
  >
    {
      topics.map(topic => {
        const topicPosts = posts.filter(post =>
          post.data.tags.includes(topic.tag)
        );
        return (
          <section class="topic-card" aria-labelledby={topic.id}>
            <h2 id={topic.id}>{topic.title}</h2>
            <p>{topic.description}</p>
            {topic.outline && <p>{topic.outline}</p>}
            {topic.href && (
              <a
                class="text-accent underline underline-offset-4"
                href={topic.href}
              >
                阅读 Ink 项目介绍与系列导读
              </a>
            )}
            {topicPosts.length > 0 ? (
              <>
                <ol class="mt-5 list-decimal space-y-3 pl-5">
                  {topicPosts.map(post => (
                    <li>
                      <a
                        class="text-accent hover:underline"
                        href={getPostUrl(post.id, post.filePath)}
                      >
                        {post.data.title}
                      </a>
                    </li>
                  ))}
                </ol>
                <p class="mt-5 text-sm">已整理 {topicPosts.length} 篇文章</p>
              </>
            ) : (
              <p class="mt-5 text-sm">
                专题筹备中，文章发布后将在这里按顺序收录。
              </p>
            )}
          </section>
        );
      })
    }
  </Main><Footer />
</Layout>
