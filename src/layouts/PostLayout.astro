---
import Layout from "./Layout.astro";
import config from "@/config";

type Props = {
  title?: string;
  articleTitle?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  isInkSeries?: boolean;
};

const { site } = config;

const {
  title,
  articleTitle,
  description,
  ogImage,
  canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
  pubDatetime,
  modDatetime,
  isInkSeries = false,
} = Astro.props;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: articleTitle ?? title ?? site.title,
  url: canonicalURL,
  mainEntityOfPage: { "@type": "WebPage", "@id": canonicalURL },
  description,
  inLanguage: Astro.currentLocale ?? site.lang,
  image: ogImage,
  ...(isInkSeries && {
    isPartOf: {
      "@type": "CollectionPage",
      "@id": new URL("ink/#webpage", Astro.site).href,
      name: "Coding Agent 原理与实践：Ink 开发手记",
    },
    about: {
      "@type": "SoftwareSourceCode",
      "@id": "https://github.com/FishInSalt/ink#source",
    },
  }),
  ...(pubDatetime && { datePublished: pubDatetime.toISOString() }),
  ...(modDatetime && { dateModified: modDatetime.toISOString() }),
  author: [
    {
      "@type": "Person",
      name: site.author,
      ...(site.profile && { url: site.profile }),
    },
  ],
};
---

<Layout {title} {description} {ogImage} {canonicalURL} ogType="article">
  <Fragment slot="head">
    {
      pubDatetime && (
        <meta
          property="article:published_time"
          content={pubDatetime.toISOString()}
        />
      )
    }
    {
      modDatetime && (
        <meta
          property="article:modified_time"
          content={modDatetime.toISOString()}
        />
      )
    }

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />
  </Fragment>

  <slot />
</Layout>
