---
import type { HTMLAttributes } from "astro/types";
import config from "@/config";
type Props = { noMarginTop?: boolean } & HTMLAttributes<"footer">;
const { noMarginTop = false, class: className, ...attrs } = Astro.props;
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div
    class="border-border text-muted-foreground flex flex-wrap items-center justify-between gap-3 border-t py-6 text-sm"
  >
    <span
      >© {new Date().getFullYear()}
      {config.site.author} / {config.site.title}</span
    >
    <nav aria-label="页脚导航" class="flex gap-5">
      <a href="/archives/" class="hover:text-accent">归档</a>
      <a href="/rss.xml" class="hover:text-accent">RSS 订阅</a>
      <a href="https://github.com/FishInSalt" class="hover:text-accent"
        >GitHub</a
      >
    </nav>
  </div>
</footer>
